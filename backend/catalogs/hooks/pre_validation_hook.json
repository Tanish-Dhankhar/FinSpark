{
  "hook_name": "pre_validation_hook",
  "hook_type": "validation",
  "description": "Validates all required input fields are present and match their expected types and rules.",
  "trigger_condition": "Before outbound adapter call",
  "applicable_adapters": [
    "*"
  ],
  "lifecycle_state": "active",
  "execution_order": 4,
  "is_blocking": true,
  "payload_template": {
    "event": "input_payload_validation",
    "client_id": "{{client_id}}",
    "adapter": "{{adapter_name}}",
    "timestamp": "{{utc_timestamp}}"
  },
  "input_parameters": [
    {
      "param_name": "adapter_name",
      "type": "string",
      "required": true,
      "description": "Target adapter",
      "default_value": ""
    },
    {
      "param_name": "adapter_version",
      "type": "string",
      "required": true,
      "description": "Version of the adapter to validate against",
      "default_value": "v1"
    },
    {
      "param_name": "input_payload",
      "type": "object",
      "required": true,
      "description": "Payload constructed for the request",
      "default_value": "{}"
    },
    {
      "param_name": "required_fields_schema",
      "type": "object",
      "required": true,
      "description": "Adapter specific schema rule definitions",
      "default_value": "{}"
    }
  ],
  "output": {
    "on_success": "validation_passed: true, validated_payload",
    "on_failure": "validation_report listing every failed field, pipeline aborted for this adapter"
  },
  "timeout_ms": 500,
  "retry_policy": {
    "max_retries": 0,
    "backoff_strategy": "none",
    "initial_delay_ms": 0
  },
  "credential_env_vars": [],
  "audit_on_trigger": true,
  "error_codes": {
    "HOOK_001": "Missing mandatory field.",
    "HOOK_002": "Type mismatch for field.",
    "HOOK_003": "Field failed explicit regex validation."
  },
  "example_log_entry": {
    "hook_name": "pre_validation_hook",
    "triggered_at": "2026-04-02T10:30:01Z",
    "client_id": "client_d22e81e7",
    "adapter": "razorpay",
    "result": "FAILED - validation_report generated: order_amount must be integer."
  }
}
