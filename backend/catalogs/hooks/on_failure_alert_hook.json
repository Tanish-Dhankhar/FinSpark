{
  "hook_name": "on_failure_alert_hook",
  "hook_type": "on-failure",
  "description": "Sends an alert payload to a configured internal webhook URL with full failure context.",
  "trigger_condition": "Whenever any adapter call fails (network error, 4xx, 5xx, timeout)",
  "applicable_adapters": [
    "*"
  ],
  "lifecycle_state": "active",
  "execution_order": 2,
  "is_blocking": false,
  "payload_template": {
    "event": "failure_alert",
    "client_id": "{{client_id}}",
    "adapter": "{{adapter_name}}",
    "timestamp": "{{utc_timestamp}}"
  },
  "input_parameters": [
    {
      "param_name": "adapter_name",
      "type": "string",
      "required": true,
      "description": "Failing Adapter",
      "default_value": ""
    },
    {
      "param_name": "adapter_version",
      "type": "string",
      "required": true,
      "description": "Failing version",
      "default_value": ""
    },
    {
      "param_name": "error_code",
      "type": "string",
      "required": true,
      "description": "HTTP status code or internal fault code",
      "default_value": ""
    },
    {
      "param_name": "error_message",
      "type": "string",
      "required": true,
      "description": "Detailed exception string",
      "default_value": ""
    },
    {
      "param_name": "request_timestamp",
      "type": "string",
      "required": true,
      "description": "Time of original failure",
      "default_value": ""
    },
    {
      "param_name": "client_id",
      "type": "string",
      "required": true,
      "description": "Client for which it failed",
      "default_value": ""
    },
    {
      "param_name": "alert_webhook_url",
      "type": "string",
      "required": true,
      "description": "Outbound webhook for Ops",
      "default_value": "https://hooks.slack.com/services/T0000/B000"
    }
  ],
  "output": {
    "on_success": "alert delivered, alert_id returned",
    "on_failure": "alert silently dropped, HOOK_002 logged"
  },
  "timeout_ms": 3000,
  "retry_policy": {
    "max_retries": 2,
    "backoff_strategy": "fixed",
    "initial_delay_ms": 500
  },
  "credential_env_vars": [
    "ALERT_WEBHOOK_SECRET"
  ],
  "audit_on_trigger": true,
  "error_codes": {
    "HOOK_001": "Failed to parse error payload.",
    "HOOK_002": "Alert destination unreachable (webhook down).",
    "HOOK_003": "Invalid Alerting Webhook Secret."
  },
  "example_log_entry": {
    "hook_name": "on_failure_alert_hook",
    "triggered_at": "2026-04-02T10:30:10Z",
    "client_id": "client_d22e81e7",
    "adapter": "karza",
    "result": "SUCCESS - Ops alert dispatched via Webhook webhook_id_992"
  }
}
