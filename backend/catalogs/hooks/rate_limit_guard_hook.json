{
  "hook_name": "rate_limit_guard_hook",
  "hook_type": "pre-call",
  "description": "Tracks call frequency using in-memory counter to prevent quota exhaustion.",
  "trigger_condition": "Before hitting the network for adapter call",
  "applicable_adapters": [
    "*"
  ],
  "lifecycle_state": "active",
  "execution_order": 3,
  "is_blocking": true,
  "payload_template": {
    "event": "rate_limit_check",
    "client_id": "{{client_id}}",
    "adapter": "{{adapter_name}}",
    "timestamp": "{{utc_timestamp}}"
  },
  "input_parameters": [
    {
      "param_name": "adapter_name",
      "type": "string",
      "required": true,
      "description": "Target Adapter",
      "default_value": ""
    },
    {
      "param_name": "client_id",
      "type": "string",
      "required": true,
      "description": "Client performing operation",
      "default_value": ""
    },
    {
      "param_name": "calls_in_window",
      "type": "integer",
      "required": true,
      "description": "Current traffic in scope",
      "default_value": "0"
    },
    {
      "param_name": "window_duration_ms",
      "type": "integer",
      "required": true,
      "description": "Bucket scale",
      "default_value": "1000"
    },
    {
      "param_name": "max_calls_per_window",
      "type": "integer",
      "required": true,
      "description": "Max TPS/RPM from catalog",
      "default_value": "10"
    }
  ],
  "output": {
    "on_success": "call allowed, current_rate attached to request context",
    "on_failure": "call delayed by calculated wait_ms, rate_limit_warning emitted"
  },
  "timeout_ms": 200,
  "retry_policy": {
    "max_retries": 0,
    "backoff_strategy": "none",
    "initial_delay_ms": 0
  },
  "credential_env_vars": [],
  "audit_on_trigger": true,
  "error_codes": {
    "HOOK_001": "Rate tracker sync token lost.",
    "HOOK_002": "Throttling wait exceeded max pipeline drift.",
    "HOOK_003": "Extreme quota overrun, blocking further requests entirely."
  },
  "example_log_entry": {
    "hook_name": "rate_limit_guard_hook",
    "triggered_at": "2026-04-02T10:30:27Z",
    "client_id": "client_d22e81e7",
    "adapter": "perfios",
    "result": "SUCCESS - Call frequency 2/sec allowed against 10/sec limit."
  }
}
