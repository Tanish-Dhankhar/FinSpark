{
    "id": "datadog_logging",
    "type": "post_call",
    "trigger_conditions": ["success", "failure"],
    "target_endpoint": "https://http-intake.logs.datadoghq.com/v1/input",
    "required_headers": {
        "DD-API-KEY": "$DATADOG_API_KEY"
    },
    "payload_template": {
        "client_id": "{{client_id}}",
        "adapter": "{{adapter_name}}",
        "status": "{{response_status}}",
        "latency_ms": "{{latency}}"
    },
    "timeout_ms": 1000
}
