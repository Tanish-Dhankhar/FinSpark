{
  "adapter_name": "Stripe Payments",
  "category": "payment",
  "description": "Create payment intents and process global payments through Stripe gateway.",
  "provider": "Stripe Inc.",
  "base_url": "https://api.stripe.com",
  "auth_type": "api_key",
  "credential_env_vars": [
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET"
  ],
  "versions": [
    {
      "version": "2022-11-15",
      "endpoint": "/v1/payment_intents",
      "status": "stable",
      "maturity_score": 8,
      "deprecated": false,
      "release_notes": "PaymentIntents with 3DS2 and SCA support",
      "sunset_date": "2025-12-31"
    },
    {
      "version": "2024-04-10",
      "endpoint": "/v1/payment_intents",
      "status": "latest",
      "maturity_score": 9,
      "deprecated": false,
      "release_notes": "Latest release with Adaptive Pricing and enhanced Radar rules",
      "sunset_date": null
    }
  ],
  "required_fields": [
    {
      "field_name": "amount",
      "type": "integer",
      "description": "Payment amount in smallest currency unit (e.g. paise for INR)",
      "validation": "Positive integer, min 50"
    },
    {
      "field_name": "currency",
      "type": "enum",
      "description": "Currency abbreviation",
      "validation": "Enum: inr/usd/eur"
    },
    {
      "field_name": "customer_id",
      "type": "string",
      "description": "Stripe Customer ID",
      "validation": "Must start with cus_"
    },
    {
      "field_name": "payment_method",
      "type": "string",
      "description": "Stripe PaymentMethod ID",
      "validation": "Must start with pm_"
    },
    {
      "field_name": "confirm",
      "type": "boolean",
      "description": "Whether to confirm the PaymentIntent immediately",
      "validation": "true or false"
    }
  ],
  "optional_fields": [
    {
      "field_name": "description",
      "type": "string",
      "description": "Description of the payment",
      "default_value": "Payment for services"
    },
    {
      "field_name": "metadata",
      "type": "object",
      "description": "Key-value pairs for tenant/loan tagging",
      "default_value": "{}"
    },
    {
      "field_name": "receipt_email",
      "type": "string",
      "description": "Email to send payment receipt",
      "default_value": "null"
    },
    {
      "field_name": "setup_future_usage",
      "type": "enum",
      "description": "Save method for future EMI mandates",
      "default_value": "null"
    }
  ],
  "response_schema": {
    "payment_intent_id": {
      "type": "string",
      "description": "Unique Stripe PaymentIntent ID (pi_xxx)"
    },
    "status": {
      "type": "enum",
      "description": "Enum: requires_payment_method/requires_action/processing/succeeded/canceled"
    },
    "amount_received": {
      "type": "integer",
      "description": "Amount actually captured in smallest currency unit"
    },
    "charge_id": {
      "type": "string",
      "description": "Underlying Charge ID (ch_xxx) once captured"
    },
    "payment_method_type": {
      "type": "string",
      "description": "Type of payment method used: card/upi/netbanking"
    },
    "next_action": {
      "type": "object",
      "description": "3DS2 redirect or OTP challenge instructions if required"
    },
    "receipt_url": {
      "type": "string",
      "description": "Hosted URL of Stripe-generated payment receipt"
    },
    "livemode": {
      "type": "boolean",
      "description": "True if live transaction, false for sandbox"
    },
    "created": {
      "type": "integer",
      "description": "Unix epoch timestamp of PaymentIntent creation"
    }
  },
  "error_codes": {
    "400": "Malformed request or missing required fields.",
    "401": "Invalid or missing Stripe Secret Key.",
    "402": "Payment declined by issuing bank.",
    "404": "PaymentIntent or Customer not found.",
    "429": "Stripe rate limit exceeded.",
    "500": "Stripe internal server error."
  },
  "timeout_ms": 30000,
  "retry_policy": {
    "max_retries": 3,
    "backoff_strategy": "exponential"
  },
  "sandbox_base_url": "https://api.stripe.com",
  "fallback_adapter": "razorpay"
}
