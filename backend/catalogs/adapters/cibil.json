{
  "adapter_name": "TransUnion CIBIL Bureau",
  "category": "bureau",
  "description": "Pull primary credit reporting and scoring records.",
  "provider": "TransUnion CIBIL",
  "base_url": "https://api.cibil.com",
  "auth_type": "oauth2",
  "credential_env_vars": [
    "CIBIL_OAUTH_CLIENT_ID",
    "CIBIL_OAUTH_CLIENT_SECRET"
  ],
  "versions": [
    {
      "version": "v1",
      "endpoint": "/v1/score",
      "status": "deprecated",
      "maturity_score": 2,
      "deprecated": true,
      "release_notes": "Legacy v1 integration",
      "sunset_date": "2024-03-31"
    },
    {
      "version": "v2",
      "endpoint": "/v2/tucibil/report",
      "status": "Stable",
      "maturity_score": 3,
      "deprecated": false,
      "release_notes": "Older static report dump",
      "sunset_date": "2026-05-04"
    },
    {
      "version": "v3",
      "endpoint": "/v3/consumer/score",
      "status": "Stable",
      "maturity_score": 9,
      "deprecated": false,
      "release_notes": "Advanced insights block included",
      "sunset_date": "2027-12-31"
    }
  ],
  "required_fields": [
    {
      "field_name": "pan_number",
      "type": "string",
      "description": "Customer PAN",
      "validation": "10 char alphanumeric"
    },
    {
      "field_name": "full_name",
      "type": "string",
      "description": "Full name exactly as per PAN",
      "validation": "min length 3"
    },
    {
      "field_name": "date_of_birth",
      "type": "date",
      "description": "Date of Birth",
      "validation": "ISO 8601 date"
    },
    {
      "field_name": "mobile_number",
      "type": "string",
      "description": "10 digit mobile number",
      "validation": "10 digit numeric"
    }
  ],
  "optional_fields": [
    {
      "field_name": "email",
      "type": "string",
      "description": "Email ID for better matching",
      "default_value": "null"
    },
    {
      "field_name": "address",
      "type": "string",
      "description": "Current address of the customer",
      "default_value": "null"
    },
    {
      "field_name": "consent_timestamp",
      "type": "date",
      "description": "When consent was given",
      "default_value": "current_timestamp"
    },
    {
      "field_name": "enquiry_purpose",
      "type": "string",
      "description": "Type of loan applied for",
      "default_value": "PERSONAL_LOAN"
    }
  ],
  "response_schema": {
    "cibil_score": {
      "type": "integer",
      "description": "Score between 300 to 900"
    },
    "score_version": {
      "type": "string",
      "description": "Underlying TU scoring model version"
    },
    "active_accounts": {
      "type": "integer",
      "description": "Number of currently active loan accounts"
    },
    "dpd_history": {
      "type": "array",
      "description": "Array of month-level arrays of Days Past Due objects"
    },
    "total_outstanding": {
      "type": "integer",
      "description": "Total principal outstanding across all loans"
    },
    "credit_utilization": {
      "type": "integer",
      "description": "Percentage utilization of revolving credit limits"
    },
    "enquiry_count": {
      "type": "integer",
      "description": "Count of hard enquiries in last 3 months"
    },
    "risk_category": {
      "type": "string",
      "description": "Label such as High Risk, Sub-prime, Prime etc."
    },
    "score_factors": {
      "type": "array",
      "description": "Array of strings explaining score drivers"
    }
  },
  "error_codes": {
    "400": "Invalid parameter provided in payload.",
    "401": "Invalid OAuth Credentials.",
    "404": "No consumer record found.",
    "429": "Exceeded contract hard limit TPS.",
    "500": "TU CIBIL underlying mainframe timeout."
  },
  "timeout_ms": 10000,
  "retry_policy": {
    "max_retries": 1,
    "backoff_strategy": "exponential"
  },
  "sandbox_base_url": "https://sandbox-api.cibil.com",
  "fallback_adapter": "experian"
}
