{
  "adapter_name": "Twilio SMS",
  "category": "messaging",
  "provider": "Twilio Inc",
  "description": "Sends transactional and promotional SMS and MMS messages globally via Twilio's carrier network. Used in lending platforms for OTP delivery during authentication, loan approval notifications, EMI payment reminders, disbursement alerts, and customer communication. Supports alphanumeric sender IDs for branded messaging and webhook callbacks for delivery status tracking.",
  "use_cases": [
    "OTP delivery for borrower authentication and eKYC",
    "Loan approval and rejection SMS notification",
    "EMI due date reminders and overdue alerts",
    "Disbursement confirmation SMS to borrower",
    "Customer onboarding welcome message",
    "Fraud alert notification to customer",
    "Password reset and security OTP",
    "Transactional alerts for payment collection"
  ],
  "semantic_tags": [
    "SMS", "messaging", "Twilio", "OTP", "text message", "notification",
    "transactional SMS", "MMS", "phone notification", "mobile alert",
    "disbursement alert", "EMI reminder", "loan notification", "borrower communication",
    "alphanumeric sender", "delivery receipt", "webhook", "carrier SMS"
  ],
  "compliance_context": "TRAI DLT (Distributed Ledger Technology) registration required for Indian SMS traffic. Sender ID and message template pre-approval needed. GDPR data handling for international messages.",
  "typical_callers": "Lending platforms for borrower communication, digital banks for OTP delivery, fintech apps for fraud alerts and payment notifications",
  "auth_description": "Basic authentication using Twilio Account SID as username and Auth Token as password, base64 encoded.",
  "auth_type": "basic_auth",
  "base_url": "https://api.twilio.com",
  "credential_env_vars": [
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN"
  ],
  "versions": [
    {
      "version": "v1",
      "endpoint": "/2010-04-01/Accounts/{AccountSid}/Messages.json",
      "status": "deprecated",
      "maturity_score": 3,
      "deprecated": true,
      "release_notes": "Legacy messaging interface",
      "sunset_date": "2024-03-31"
    },
    {
      "version": "v2",
      "endpoint": "/v2/Accounts/{AccountSid}/Messages.json",
      "status": "stable",
      "maturity_score": 7,
      "deprecated": false,
      "release_notes": "Enhanced delivery tracking",
      "sunset_date": "2026-04-04"
    },
    {
      "version": "v3",
      "endpoint": "/v3/Accounts/{AccountSid}/Messages.json",
      "status": "stable",
      "maturity_score": 9,
      "deprecated": false,
      "release_notes": "Advanced analytics and RCS support",
      "sunset_date": "2031-12-31"
    }
  ],
  "required_fields": [
    {
      "field_name": "to",
      "type": "string",
      "description": "Destination phone number in E.164 format",
      "validation": "E.164 format e.g. +91XXXXXXXXXX"
    },
    {
      "field_name": "from",
      "type": "string",
      "description": "Twilio-provisioned sender number or alphanumeric ID",
      "validation": "E.164 format or alphanumeric sender ID"
    },
    {
      "field_name": "body",
      "type": "string",
      "description": "Text content of the SMS message",
      "validation": "Max 1600 characters"
    },
    {
      "field_name": "account_sid",
      "type": "string",
      "description": "Twilio Account SID for request routing",
      "validation": "AC-prefixed alphanumeric string"
    }
  ],
  "optional_fields": [
    {
      "field_name": "media_url",
      "type": "string",
      "description": "Media URL for MMS attachment",
      "default_value": "null"
    },
    {
      "field_name": "status_callback",
      "type": "string",
      "description": "Webhook URL to receive delivery status events",
      "default_value": "null"
    },
    {
      "field_name": "messaging_service_sid",
      "type": "string",
      "description": "SID of a messaging service pool for sender rotation",
      "default_value": "null"
    },
    {
      "field_name": "validity_period",
      "type": "integer",
      "description": "Seconds the message remains valid in carrier network",
      "default_value": "14400"
    }
  ],
  "response_schema": {
    "message_sid": { "type": "string", "description": "Unique Twilio message identifier" },
    "status": { "type": "enum", "description": "queued/sent/delivered/failed" },
    "date_sent": { "type": "date", "description": "Dispatch timestamp" },
    "error_code": { "type": "string", "description": "Twilio error code if failed" }
  },
  "error_codes": {
    "400": "Invalid To or From number.",
    "401": "Invalid SID or Auth Token.",
    "404": "Resource not found.",
    "429": "Too many concurrent requests.",
    "500": "Carrier connection error."
  },
  "timeout_ms": 3000,
  "retry_policy": { "max_retries": 3, "backoff_strategy": "exponential" },
  "sandbox_base_url": "https://api.twilio.com/sandbox",
  "fallback_adapter": null
}