{
  "adapter_name": "Razorpay Payments",
  "category": "payment",
  "provider": "Razorpay Software Pvt Ltd",
  "description": "Processes online payments through the Razorpay payment gateway for Indian merchants. Supports UPI, credit/debit cards, net banking, and wallet transactions. Used by lending platforms to collect EMI repayments, disbursal fee collections, and one-time loan origination charges. Provides real-time payment status, refund management, and webhook delivery for payment confirmation events.",
  "use_cases": [
    "EMI repayment collection from borrowers",
    "Loan origination fee or processing fee collection",
    "One-time payment for service activation",
    "Refund issuance to borrowers on cancellations",
    "Payment link generation for customer-initiated payments",
    "Subscription and recurring mandate setup",
    "Bulk disbursal payment collection reconciliation"
  ],
  "semantic_tags": [
    "payment", "payment gateway", "Razorpay", "UPI", "card payment", "net banking",
    "EMI collection", "loan repayment", "transaction", "refund", "payment processing",
    "digital payment", "payout", "merchant payment", "checkout", "online payment",
    "INR payment", "India payment gateway"
  ],
  "compliance_context": "Compliant with RBI Payment Aggregator guidelines 2020. PCI-DSS Level 1 certified. Two-factor authentication mandated for card transactions per RBI directive.",
  "typical_callers": "Fintech lending apps, e-commerce platforms, SaaS subscription platforms, digital banks, insurance platforms collecting premiums",
  "auth_description": "Basic authentication using Razorpay Key ID and Key Secret passed as username:password in base64-encoded Authorization header.",
  "auth_type": "basic_auth",
  "base_url": "https://api.razorpay.com",
  "credential_env_vars": [
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET"
  ],
  "versions": [
    {
      "version": "v1",
      "endpoint": "/v1/orders",
      "status": "stable",
      "maturity_score": 9,
      "deprecated": false,
      "release_notes": "Standard order creation endpoint",
      "sunset_date": "2027-12-31"
    },
    {
      "version": "v2",
      "endpoint": "/v2/orders",
      "status": "beta",
      "maturity_score": 6,
      "deprecated": false,
      "release_notes": "Beta optimized routing",
      "sunset_date": null
    }
  ],
  "required_fields": [
    {
      "field_name": "order_amount",
      "type": "integer",
      "description": "Payment amount in paise (1 INR = 100 paise)",
      "validation": "Positive integer"
    },
    {
      "field_name": "currency",
      "type": "enum",
      "description": "Currency code for the transaction",
      "validation": "Enum: INR/USD"
    },
    {
      "field_name": "customer_id",
      "type": "string",
      "description": "Unique customer identifier in the merchant system",
      "validation": "Alphanumeric string"
    },
    {
      "field_name": "order_id",
      "type": "string",
      "description": "Unique order reference from the internal system",
      "validation": "Alphanumeric up to 40 chars"
    },
    {
      "field_name": "payment_method",
      "type": "enum",
      "description": "Payment instrument to be used",
      "validation": "Enum: upi/card/netbanking/wallet"
    }
  ],
  "optional_fields": [
    {
      "field_name": "description",
      "type": "string",
      "description": "Human-readable description of the payment",
      "default_value": "Payment for services"
    },
    {
      "field_name": "receipt",
      "type": "string",
      "description": "Internal receipt reference for reconciliation",
      "default_value": "null"
    },
    {
      "field_name": "notes",
      "type": "string",
      "description": "Key-value notes for internal tagging",
      "default_value": "{}"
    },
    {
      "field_name": "callback_url",
      "type": "string",
      "description": "Webhook URL to receive payment status events",
      "default_value": "null"
    }
  ],
  "response_schema": {
    "payment_id": { "type": "string", "description": "Unique Razorpay payment ID" },
    "order_id": { "type": "string", "description": "Associated Razorpay order ID" },
    "status": { "type": "enum", "description": "created/authorized/captured/failed" },
    "method": { "type": "string", "description": "Payment method captured" },
    "amount_paid": { "type": "integer", "description": "Amount paid in paise" },
    "fee": { "type": "integer", "description": "Razorpay processing fee in paise" },
    "upi_transaction_ref": { "type": "string", "description": "UPI RRN reference number" },
    "captured_at": { "type": "integer", "description": "Unix epoch timestamp of capture" }
  },
  "error_codes": {
    "400": "Bad request on amount or currency.",
    "401": "Invalid basic auth credentials.",
    "404": "Order or Payment not found.",
    "429": "Exceeded Razorpay rate limit.",
    "500": "Razorpay internal upstream failure."
  },
  "timeout_ms": 5000,
  "retry_policy": { "max_retries": 1, "backoff_strategy": "fixed" },
  "sandbox_base_url": "https://api.razorpay.com/sandbox",
  "fallback_adapter": null
}
