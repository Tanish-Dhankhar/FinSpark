{
  "adapter_name": "RiskGuard Analytics Engine",
  "category": "fraud",
  "description": "Internal fraud detection engine evaluating multi-dimensional risk.",
  "provider": "RiskGuard Analytics",
  "base_url": "https://api.riskguard.internal",
  "auth_type": "bearer_token",
  "credential_env_vars": [
    "RISKGUARD_BEARER_TOKEN"
  ],
  "versions": [
    {
      "version": "v1",
      "endpoint": "/v1/evaluate",
      "status": "deprecated",
      "maturity_score": 4,
      "deprecated": true,
      "release_notes": "Rule-based fraud checking only",
      "sunset_date": "2025-04-30"
    },
    {
      "version": "v2",
      "endpoint": "/v2/risk-assessment",
      "status": "stable",
      "maturity_score": 8,
      "deprecated": false,
      "release_notes": "ML based scoring including device fingerprinting",
      "sunset_date": "2028-03-31"
    },
    {
      "version": "v3",
      "endpoint": "/v3/risk-assessment",
      "status": "beta",
      "maturity_score": 5,
      "deprecated": false,
      "release_notes": "Includes synthetic identity correlation graphs",
      "sunset_date": null
    }
  ],
  "required_fields": [
    {
      "field_name": "applicant_id",
      "type": "string",
      "description": "Unique applicant or session tracking id",
      "validation": "Alphanumeric"
    },
    {
      "field_name": "pan_number",
      "type": "string",
      "description": "Customer PAN",
      "validation": "10 char alphanumeric"
    },
    {
      "field_name": "mobile_number",
      "type": "string",
      "description": "Mobile number",
      "validation": "10 digit numeric"
    },
    {
      "field_name": "ip_address",
      "type": "string",
      "description": "Originating IPv4 or IPv6",
      "validation": "Valid IP Address"
    },
    {
      "field_name": "device_fingerprint",
      "type": "string",
      "description": "Session generated hardware hash",
      "validation": "string"
    },
    {
      "field_name": "loan_amount_requested",
      "type": "integer",
      "description": "Requested principal",
      "validation": "Positive integer"
    }
  ],
  "optional_fields": [
    {
      "field_name": "email",
      "type": "string",
      "description": "Email ID for breach checking",
      "default_value": "null"
    },
    {
      "field_name": "employment_type",
      "type": "string",
      "description": "Self-employed or Salaried",
      "default_value": "null"
    },
    {
      "field_name": "pincode",
      "type": "string",
      "description": "Current address PIN",
      "default_value": "null"
    },
    {
      "field_name": "bureau_score",
      "type": "integer",
      "description": "Previously fetched bureau score if available",
      "default_value": "0"
    }
  ],
  "response_schema": {
    "risk_score": {
      "type": "integer",
      "description": "Score between 0 and 1000"
    },
    "risk_band": {
      "type": "enum",
      "description": "Enum: LOW/MEDIUM/HIGH/VERY_HIGH"
    },
    "fraud_flags": {
      "type": "array",
      "description": "Array of triggered fraud rules as strings"
    },
    "velocity_check_result": {
      "type": "string",
      "description": "Summary of repeated recent attempts"
    },
    "blacklist_match": {
      "type": "boolean",
      "description": "True if entity matches known bad lists"
    },
    "synthetic_identity_score": {
      "type": "integer",
      "description": "Probability of non-existent entity identity"
    },
    "recommended_action": {
      "type": "enum",
      "description": "Enum: APPROVE/REVIEW/REJECT"
    }
  },
  "error_codes": {
    "400": "Invalid IP address formatting or missing fields.",
    "401": "Missing or invalid bearer token.",
    "403": "Token does not have permission for risk evaluate.",
    "429": "Rate limit exceeded on risk engine.",
    "500": "Risk model engine timeout."
  },
  "timeout_ms": 4000,
  "retry_policy": {
    "max_retries": 1,
    "backoff_strategy": "fixed"
  },
  "sandbox_base_url": "https://sandbox-api.riskguard.internal",
  "fallback_adapter": null
}
